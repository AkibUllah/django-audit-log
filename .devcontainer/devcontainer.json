{
  "name": "django-audit-log",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "containerEnv": {
    "DJANGO_ALLOWED_HOSTS": "localhost,127.0.0.1,.app.github.dev",
    "DJANGO_CSRF_TRUSTED_ORIGINS": "https://*.app.github.dev",
    "DJANGO_SEED_DEMO": "true"
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -e \".[dev]\"",
  "postStartCommand": "docker compose up -d --build",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Example project (admin / admin12345)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
