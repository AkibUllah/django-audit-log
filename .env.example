# Settings for the example project in example/. The library itself needs no configuration.
DJANGO_SECRET_KEY=example-only-secret-key-not-for-production-0123456789
DJANGO_DEBUG=true
# "sqlite" (default) or "postgres" (uses the POSTGRES_* values below, as in docker-compose)
DJANGO_DB=sqlite
POSTGRES_DB=audit_example
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
POSTGRES_HOST=db
POSTGRES_PORT=5432
