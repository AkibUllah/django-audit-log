# Settings for the example project in example/. The library itself needs no configuration.
DJANGO_SECRET_KEY=example-only-secret-key-not-for-production-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to POST to the admin when behind a TLS proxy, e.g. https://*.app.github.dev
DJANGO_CSRF_TRUSTED_ORIGINS=
# Containers only: run `seed_shop` after migrate so the audit trail has demo rows
DJANGO_SEED_DEMO=true
# "sqlite" (default) or "postgres" (uses the POSTGRES_* values below, as in docker-compose)
DJANGO_DB=sqlite
POSTGRES_DB=audit_example
POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
POSTGRES_HOST=db
POSTGRES_PORT=5432
